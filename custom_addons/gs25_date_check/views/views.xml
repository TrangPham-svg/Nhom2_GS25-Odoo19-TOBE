<odoo>
    <!-- Hiển thị trạng thái trên biểu mẫu số lô -->
    <record id="view_stock_lot_form_gs25_date_check" model="ir.ui.view">
        <field name="name">stock.lot.form.gs25.date.check</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expiration_date']" position="after">
                <field name="gs25_expiry_status" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Danh sách kiểm tra hạn sử dụng -->
    <record id="view_gs25_date_check_list" model="ir.ui.view">
        <field name="name">gs25.date.check.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list string="Kiểm tra hạn sử dụng" create="false">
                <field name="name" string="Số lô"/>
                <field name="product_id" string="Sản phẩm"/>
                <field name="product_qty" string="Số lượng tồn"/>
                <field name="expiration_date" string="Ngày hết hạn"/>
                <field name="gs25_expiry_status" string="Trạng thái"/>
            </list>
        </field>
    </record>

    <!-- Mở danh sách lô cận hạn và hết hạn -->
    <record id="action_gs25_date_check" model="ir.actions.act_window">
        <field name="name">GS25 Date Check</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_gs25_date_check_list"/>
        <field name="domain">[('expiration_date', '!=', False), ('expiration_date', '&lt;=', (context_today() + datetime.timedelta(days=2)).strftime('%Y-%m-%d 23:59:59'))]</field>
    </record>

    <!-- Menu quản lý Date Check -->
    <menuitem
        id="menu_gs25_date_check_root"
        name="GS25 Date Check"
        sequence="50"
    />

    <menuitem
        id="menu_gs25_date_check_lots"
        name="Danh sách hàng cận hạn"
        parent="menu_gs25_date_check_root"
        action="action_gs25_date_check"
        sequence="10"
    />
</odoo>
