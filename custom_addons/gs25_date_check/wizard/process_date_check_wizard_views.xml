<odoo>
    <!-- GIAO DIỆN WIZARD THỰC HIỆN XỬ LÝ -->
    <record id="view_gs25_date_check_process_wizard_form"
            model="ir.ui.view">

        <field name="name">gs25.date.check.process.wizard.form</field>
        <field name="model">gs25.date.check.process.wizard</field>

        <field name="arch" type="xml">

            <form string="Thực hiện xử lý hàng hóa">

                <!-- 1. THÔNG BÁO PHƯƠNG ÁN ƯU TIÊN BÁN -->

                <div class="alert alert-success"
                     role="alert"
                     invisible="proposed_action != 'priority_sale'">

                    <strong>Ưu tiên bán hàng hóa</strong>

                    Hệ thống sẽ đánh dấu lô hàng cần ưu tiên bán.
                    Phương án này không làm thay đổi tồn kho.

                </div>

                <!-- 2. THÔNG BÁO PHƯƠNG ÁN THEO DÕI -->

                <div class="alert alert-info"
                     role="alert"
                     invisible="proposed_action != 'monitor'">

                    <strong>Tiếp tục theo dõi hàng hóa</strong>

                    Vui lòng thiết lập thời điểm kiểm tra lại.
                    Hệ thống sẽ ghi nhận lịch kiểm tra
                    và cảnh báo khi quá hạn.

                </div>

                <!-- 3. THÔNG BÁO PHƯƠNG ÁN LOẠI BỎ -->

                <div class="alert alert-warning"
                     role="alert"
                     invisible="proposed_action != 'remove'">

                    <strong>Cảnh báo: Loại bỏ hàng hóa!</strong>

                    Hệ thống sẽ tạo phiếu Scrap
                    và cập nhật giảm tồn kho.

                    Vui lòng kiểm tra hàng hóa thực tế
                    trước khi xác nhận thực hiện.

                </div>

                <!-- 4. THÔNG TIN PHIẾU KIỂM TRA -->

                <group string="Thông tin phiếu kiểm tra">

                    <group>

                        <field name="record_id"
                               readonly="1"
                               options="{'no_open': True}"/>

                        <field name="lot_id"
                               readonly="1"/>

                        <field name="product_id"
                               readonly="1"/>

                        <field name="expiration_date"
                               readonly="1"/>

                    </group>

                    <group>

                        <field name="quality_result"
                               readonly="1"/>

                        <field name="proposed_action"
                               readonly="1"/>

                        <field name="checked_quantity"
                               readonly="1"/>

                        <field name="nvt_quantity"
                               readonly="1"/>

                    </group>

                </group>

                <!-- 5. THỜI ĐIỂM KIỂM TRA LẠI -->

                <group string="Lịch kiểm tra lại"
                       invisible="proposed_action != 'monitor'">

                    <field name="next_check_date"
                           required="proposed_action == 'monitor'"/>

                </group>

                <!-- 6. GHI CHÚ THỰC HIỆN -->

                <group string="Ghi chú thực hiện">

                    <field name="processing_note"
                           nolabel="1"
                           colspan="2"
                           widget="text"
                           required="proposed_action == 'remove'"
                           placeholder="Nhập thông tin thực hiện phương án xử lý hàng hóa..."/>

                </group>

                <!-- 7. NÚT XÁC NHẬN -->

                <footer>

                    <button name="action_confirm_process"
                            type="object"
                            string="Xác nhận thực hiện"
                            class="btn-primary"
                            invisible="proposed_action == 'remove'"/>

                    <button name="action_confirm_process"
                            type="object"
                            string="Xác nhận loại bỏ"
                            class="btn-danger"
                            invisible="proposed_action != 'remove'"
                            confirm="Xác nhận loại bỏ sẽ làm giảm tồn kho. Bạn có chắc chắn muốn tiếp tục không?"/>

                    <button string="Đóng"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>
