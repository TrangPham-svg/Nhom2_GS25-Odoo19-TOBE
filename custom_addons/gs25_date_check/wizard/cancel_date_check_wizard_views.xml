<odoo>
    <!-- GIAO DIỆN WIZARD HỦY PHIẾU -->
    <record id="view_gs25_date_check_cancel_wizard_form"
            model="ir.ui.view">

        <field name="name">gs25.date.check.cancel.wizard.form</field>
        <field name="model">gs25.date.check.cancel.wizard</field>

        <field name="arch" type="xml">

            <form string="Hủy phiếu kiểm tra">

                <!-- Thông báo cảnh báo -->
                <div class="alert alert-warning"
                     role="alert">

                    <strong>Xác nhận hủy phiếu kiểm tra</strong>

                    Phiếu sau khi hủy sẽ không thể
                    chỉnh sửa, xác nhận hoặc thực hiện xử lý.

                    Thông tin phiếu vẫn được lưu
                    để truy xuất lịch sử.

                </div>

                <!-- Thông tin phiếu -->
                <group>

                    <field name="record_id"
                           readonly="1"
                           options="{'no_open': True}"/>

                    <field name="lot_id"
                           readonly="1"/>

                    <field name="product_id"
                           readonly="1"/>

                </group>

                <!-- Lý do hủy -->
                <group string="Thông tin hủy phiếu">

                    <field name="cancel_reason"
                           required="1"
                           nolabel="1"
                           colspan="2"
                           widget="text"
                           placeholder="Nhập lý do hủy phiếu kiểm tra..."/>

                </group>

                <!-- Nút xác nhận -->
                <footer>

                    <button name="action_confirm_cancel"
                            type="object"
                            string="Xác nhận hủy"
                            class="btn-danger"/>

                    <button string="Đóng"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>
