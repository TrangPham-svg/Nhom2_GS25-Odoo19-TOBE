<odoo>
    <!-- A09. GIAO DIỆN WIZARD TỪ CHỐI ĐỀ XUẤT -->
    <record id="view_gs25_replenishment_reject_wizard_form"
            model="ir.ui.view">

        <field name="name">gs25.replenishment.reject.wizard.form</field>
        <field name="model">gs25.replenishment.reject.wizard</field>

        <field name="arch" type="xml">

            <form string="Từ chối đề xuất">

                <!-- Thông báo cảnh báo -->
                <div class="alert alert-warning" role="alert">
                    <strong>Xác nhận từ chối đề xuất đặt hàng</strong>
                    Phiếu sau khi từ chối sẽ không thể duyệt hoặc tạo đơn.
                    Sản phẩm sẽ được đề xuất lại ở lần kiểm tra tồn kho sau
                    nếu vẫn dưới mức tối thiểu.
                </div>

                <!-- Thông tin phiếu -->
                <group>
                    <field name="proposal_id" readonly="1" options="{'no_open': True}"/>
                    <field name="line_count" readonly="1"/>
                    <field name="total_suggested_qty" readonly="1"/>
                </group>

                <!-- Lý do từ chối -->
                <group string="Lý do từ chối">
                    <field name="reject_reason"
                           required="1"
                           nolabel="1"
                           colspan="2"
                           widget="text"
                           placeholder="Nhập lý do từ chối đề xuất..."/>
                </group>

                <footer>
                    <button name="action_confirm_reject"
                            type="object"
                            string="Xác nhận từ chối"
                            class="btn-danger"/>
                    <button string="Đóng"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>

        </field>

    </record>
</odoo>
