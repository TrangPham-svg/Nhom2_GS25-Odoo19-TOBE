<odoo>
    <!-- A11. GIAO DIỆN WIZARD PHẢN HỒI CỦA KHO TỔNG (MÔ PHỎNG) -->
    <record id="view_gs25_dw_response_wizard_form"
            model="ir.ui.view">

        <field name="name">gs25.dw.response.wizard.form</field>
        <field name="model">gs25.dw.response.wizard</field>

        <field name="arch" type="xml">

            <form string="Phản hồi của kho tổng">

                <div class="alert alert-info"
                     role="alert"
                     invisible="mode != 'partial'">
                    <strong>Kho tổng chỉ đáp ứng một phần.</strong>
                    Nhập số lượng kho tổng có thể giao cho từng sản phẩm.
                    Phiếu nhập dự kiến tại cửa hàng sẽ được cập nhật theo.
                </div>

                <div class="alert alert-danger"
                     role="alert"
                     invisible="mode != 'reject'">
                    <strong>Kho tổng từ chối đơn đặt hàng.</strong>
                    Đơn và phiếu nhập dự kiến sẽ bị hủy.
                </div>

                <group>
                    <field name="purchase_id" readonly="1" options="{'no_open': True}"/>
                    <field name="mode" readonly="1"/>
                </group>

                <field name="line_ids" invisible="mode != 'partial'">
                    <list create="false" delete="false" editable="bottom">
                        <field name="purchase_line_id" column_invisible="1" force_save="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="ordered_qty" readonly="1"/>
                        <field name="available_qty"/>
                        <field name="uom_id" readonly="1"/>
                    </list>
                </field>

                <group string="Lý do / ghi chú">
                    <field name="note"
                           required="1"
                           nolabel="1"
                           colspan="2"
                           widget="text"
                           placeholder="Ví dụ: Kho tổng tạm hết hàng..."/>
                </group>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Xác nhận"
                            class="btn-primary"/>
                    <button string="Đóng"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>

        </field>

    </record>
</odoo>
