<odoo>
    <!-- 1. MENU GỐC GS25 ĐẶT HÀNG BỔ SUNG -->
    <menuitem
        id="menu_gs25_replenishment_root"
        name="GS25 Đặt hàng bổ sung"
        groups="gs25_replenishment.group_gs25_replenishment_user,gs25_replenishment.group_gs25_replenishment_central"
        sequence="51"
    />

    <menuitem
        id="menu_gs25_replenishment_operations"
        name="Nghiệp vụ"
        parent="menu_gs25_replenishment_root"
        sequence="10"
    />

    <menuitem
        id="menu_gs25_replenishment_reporting"
        name="Báo cáo"
        parent="menu_gs25_replenishment_root"
        groups="gs25_replenishment.group_gs25_replenishment_user"
        sequence="80"
    />

    <menuitem
        id="menu_gs25_replenishment_config"
        name="Cấu hình"
        parent="menu_gs25_replenishment_root"
        groups="gs25_replenishment.group_gs25_replenishment_manager"
        sequence="90"
    />


    <!-- 2. A01. GIAO DIỆN CẤU HÌNH INVENTORY VÀ PURCHASE -->
    <record id="view_res_company_gs25_replenishment_form"
            model="ir.ui.view">

        <field name="name">res.company.gs25.replenishment.form</field>
        <field name="model">res.company</field>
        <field name="priority">99</field>

        <field name="arch" type="xml">

            <form string="Cấu hình đặt hàng bổ sung"
                  create="false"
                  delete="false">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <strong>Cấu hình đặt hàng bổ sung GS25.</strong>
                        Kho cửa hàng nhận hàng bổ sung từ kho tổng.
                        Kho tổng được mô phỏng như một nhà cung cấp
                        trong Purchase để nhận đơn đặt hàng điện tử.
                    </div>

                    <group>

                        <group string="Inventory và Purchase">

                            <field name="gs25_store_warehouse_id"
                                   placeholder="Để trống: tự tìm kho mã NVT"/>

                            <field name="gs25_central_partner_id"
                                   placeholder="Để trống: Kho tổng GS25 (mô phỏng)"/>

                            <field name="gs25_auto_check"/>

                        </group>

                        <group string="Tham số tính đề xuất">

                            <field name="gs25_sales_history_days"/>

                            <field name="gs25_lead_days"/>

                            <field name="gs25_coverage_days"/>

                        </group>

                    </group>

                    <group string="Kiểm tra cấu hình">

                        <field name="gs25_config_warning"
                               nolabel="1"
                               colspan="2"
                               readonly="1"/>

                    </group>

                    <div class="text-muted">
                        Công thức đề xuất: Mức mục tiêu = max(Tồn tối đa,
                        Tồn tối thiểu + Bán TB/ngày × (Thời gian giao + Số ngày dự trữ)).
                        Số lượng đề xuất = Mức mục tiêu − Tồn dự báo,
                        làm tròn lên theo bội số đặt hàng.
                    </div>

                </sheet>

            </form>

        </field>

    </record>


    <!-- 3. ACTION MỞ CẤU HÌNH CỦA CÔNG TY HIỆN TẠI -->
    <record id="action_gs25_replenishment_config"
            model="ir.actions.server">

        <field name="name">Cấu hình đặt hàng bổ sung</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = model.action_gs25_open_replenishment_config()</field>

    </record>

    <menuitem
        id="menu_gs25_replenishment_settings"
        name="Thiết lập chung"
        parent="menu_gs25_replenishment_config"
        action="action_gs25_replenishment_config"
        groups="base.group_system"
        sequence="10"
    />

</odoo>
