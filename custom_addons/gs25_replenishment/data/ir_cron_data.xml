<odoo>
    <data noupdate="1">
        <!-- A05. Tự động kiểm tra tồn kho và lập phiếu đề xuất mỗi ngày -->
        <record id="ir_cron_gs25_replenishment_check" model="ir.cron">
            <field name="name">GS25 - Kiểm tra tồn kho và lập đề xuất đặt hàng</field>
            <field name="model_id" ref="model_gs25_replenishment_proposal"/>
            <field name="state">code</field>
            <field name="code">model._gs25_cron_generate_proposals()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
